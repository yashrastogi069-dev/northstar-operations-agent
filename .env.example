# Northstar local development configuration.
# Copy this file to .env and replace every CHANGE_ME value.
# Never commit .env or paste secret values into chat or GitHub.

NODE_ENV=development
PORT=3004

# Dedicated MySQL/TiDB database. Do not point this at Atlas production data.
DATABASE_URL=mysql://northstar_user:CHANGE_ME@127.0.0.1:3306/northstar_local

# Session signing secret. Generate a long random value locally.
JWT_SECRET=CHANGE_ME_generate_a_32_byte_random_secret

# External OIDC authentication. Auth0 is the documented example.
AUTH_PROVIDER=oidc
OIDC_ISSUER_URL=https://CHANGE_ME.us.auth0.com
OIDC_CLIENT_ID=CHANGE_ME_auth0_client_id
OIDC_CLIENT_SECRET=CHANGE_ME_auth0_client_secret
OIDC_SCOPE=openid profile email
VITE_AUTH_PROVIDER=oidc
VITE_OIDC_ISSUER_URL=https://CHANGE_ME.us.auth0.com
VITE_OIDC_CLIENT_ID=CHANGE_ME_auth0_client_id
VITE_OIDC_SCOPE=openid profile email
# Optional Auth0 API audience; leave blank unless an Auth0 API was created.
VITE_OIDC_AUDIENCE=

# Server-side OpenAI-compatible model endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=CHANGE_ME_openai_api_key
LLM_MODEL=gpt-4o-mini

# S3-compatible object storage, for example Cloudflare R2 or AWS S3.
S3_ENDPOINT=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=northstar-local
S3_ACCESS_KEY_ID=CHANGE_ME_storage_access_key_id
S3_SECRET_ACCESS_KEY=CHANGE_ME_storage_secret_access_key

# Optional Qdrant vector retrieval. Leave blank to use governed hybrid fallback.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=northstar-knowledge

# Optional external notification webhook. Leave blank to disable notifications.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=

# Owner identity used for local admin-oriented behavior and notifications.
OWNER_OPEN_ID=oidc:CHANGE_ME_subject
OWNER_NAME=Northstar Local Admin

# Legacy managed variables are intentionally not used in non-Manus mode.
# Do not add BUILT_IN_FORGE_API_URL or BUILT_IN_FORGE_API_KEY for this setup.
