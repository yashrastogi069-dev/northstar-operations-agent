# Northstar local development configuration
# Copy this file to .env and replace every placeholder with a real value.
# Never commit .env or any credential-bearing file.

# Dedicated local or hosted MySQL/TiDB database. Do not use Atlas production data.
DATABASE_URL=mysql://northstar_user:change-me@127.0.0.1:3306/northstar_local

# Generate a long random value for local cookie signing.
JWT_SECRET=replace-with-a-long-random-local-secret

# Managed OAuth values for a local test identity, or your approved external OIDC values.
VITE_APP_ID=replace-with-northstar-oauth-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im/app-auth

# Built-in model/storage/notification proxy values for managed local testing.
# Obtain these from your authorized development environment; never commit them.
BUILT_IN_FORGE_API_URL=https://api.manus.im
BUILT_IN_FORGE_API_KEY=replace-with-authorized-server-api-key
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im
VITE_FRONTEND_FORGE_API_KEY=replace-with-authorized-frontend-api-key

# Owner identity used for notifications and admin-oriented local testing.
OWNER_OPEN_ID=replace-with-test-owner-open-id
OWNER_NAME=Northstar Local Operator

# Optional local port. The launcher defaults to 3004 if this is omitted.
PORT=3004
NODE_ENV=development
