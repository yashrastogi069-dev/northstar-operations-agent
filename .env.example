# Northstar local development configuration.
# Copy this file to .env and replace every CHANGE_ME value.
# Never commit .env or paste secret values into chat or GitHub.

NODE_ENV=development
PORT=3004

# Local-only access. The server rejects this mode in production and for non-local requests.
NORTHSTAR_ACCESS_MODE=local-operator
NORTHSTAR_LOCAL_NO_AUTH=true
NORTHSTAR_LOCAL_OPERATOR_ID=local-operator
NORTHSTAR_LOCAL_OPERATOR_NAME=Local Northstar Operator

# OAuth is not needed in local-operator mode. Do not put fake values here.
AUTH_PROVIDER=
VITE_AUTH_PROVIDER=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional for non-Auth0 providers; Auth0 defaults to <issuer>/v2/logout.
OIDC_LOGOUT_URL=
VITE_OIDC_ISSUER_URL=
VITE_OIDC_CLIENT_ID=

# Dedicated MySQL/TiDB database. Do not point this at Atlas production data.
DATABASE_URL=mysql://northstar_user:CHANGE_ME@127.0.0.1:3306/northstar_local

# Session signing secret. Generate a long random value locally.
JWT_SECRET=CHANGE_ME_generate_a_32_byte_random_secret

# For a non-local deployment, replace the blank local auth values above with one
# complete external OIDC configuration. Do not mix both modes in the same .env.

# Server-side OpenAI-compatible model endpoint. OpenRouter example:
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=CHANGE_ME_openrouter_api_key
LLM_MODEL=openai/gpt-4o-mini
# Embeddings enable real semantic retrieval; legacy rows remain keyword-searchable.
EMBEDDING_MODEL=openai/text-embedding-3-small

# S3-compatible object storage, for example Cloudflare R2 or AWS S3.
S3_ENDPOINT=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=northstar-local
S3_ACCESS_KEY_ID=CHANGE_ME_storage_access_key_id
S3_SECRET_ACCESS_KEY=CHANGE_ME_storage_secret_access_key

# Northstar stores chunk embeddings in TiDB as JSON and combines them with keyword fallback.
# No separate vector database is required for the current hybrid retrieval path.

# Optional analytics. Leave both blank locally to disable browser analytics safely.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional external notification webhook. Leave blank to disable notifications.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=

# Stable administrator bootstrap for external OIDC deployments. Use the email from Auth0.
# ADMIN_EMAILS may contain multiple comma-separated addresses.
ADMIN_EMAILS=admin@example.com
# Optional owner subject used for legacy owner-specific behavior and notifications.
OWNER_OPEN_ID=oidc:CHANGE_ME_subject
OWNER_NAME=Northstar Local Admin

# Legacy managed variables are intentionally not used in non-Manus mode.
# Do not add BUILT_IN_FORGE_API_URL or BUILT_IN_FORGE_API_KEY for this setup.
